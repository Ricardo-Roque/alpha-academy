# Cache para Netlify / Cloudflare Pages (a Vercel usa o vercel.json).
# Fontes nunca mudam; imagens têm hash no nome; JS/CSS revalidam a cada visita (deploy aparece na hora).
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/offer/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/misc/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/*
  X-Content-Type-Options: nosniff
